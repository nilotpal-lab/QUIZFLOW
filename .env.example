# ================================================================
# QuizFlow — Environment Variables (copy to .env.local and fill in)
# NEVER commit real values.
# ================================================================

# ── Supabase (database + auth + realtime) ─────────────────────────
# Project URL and public anon key from Supabase Dashboard > Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI Quiz Generation (fallback tiers, at least one recommended) ──
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Team Login Session (step 2 / middleware) ───────────────────────
# Secret used to sign the httpOnly team-session JWT (HS256, Web Crypto).
# REQUIRED for production — without it a dev-only fallback secret is used.
QUIZFLOW_SESSION_SECRET=

# Set to "1" to disable the middleware session gate for local/legacy
# demos that use the classic PIN + nickname room mode instead of the
# team-login event flow.
QUIZFLOW_DISABLE_SESSION_GATE=
