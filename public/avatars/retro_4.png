<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <rect width="200" height="200" fill="#1a3a1a"/>
  <!-- jungle bg leaves -->
  <ellipse cx="15" cy="100" rx="25" ry="40" fill="#2d6a2d" opacity="0.7"/>
  <ellipse cx="185" cy="80" rx="25" ry="40" fill="#2d6a2d" opacity="0.7"/>
  <!-- adventurer body -->
  <rect x="70" y="115" width="60" height="55" rx="4" fill="#8B4513" shape-rendering="crispEdges"/>
  <rect x="74" y="119" width="52" height="47" fill="#A0522D" shape-rendering="crispEdges"/>
  <!-- chest pocket -->
  <rect x="80" y="125" width="18" height="14" fill="#6B3410" shape-rendering="crispEdges"/>
  <!-- face -->
  <rect x="78" y="62" width="44" height="46" rx="8" fill="#DEB887" shape-rendering="crispEdges"/>
  <!-- eyes -->
  <rect x="84" y="76" width="8" height="8" fill="#4a3000" shape-rendering="crispEdges"/>
  <rect x="108" y="76" width="8" height="8" fill="#4a3000" shape-rendering="crispEdges"/>
  <rect x="86" y="77" width="4" height="3" fill="white" shape-rendering="crispEdges"/>
  <rect x="110" y="77" width="4" height="3" fill="white" shape-rendering="crispEdges"/>
  <!-- smile -->
  <rect x="88" y="92" width="24" height="4" rx="2" fill="#8B4513"/>
  <!-- pith hat -->
  <rect x="70" y="50" width="60" height="16" rx="4" fill="#D2691E" shape-rendering="crispEdges"/>
  <rect x="80" y="38" width="40" height="16" rx="4" fill="#CD853F" shape-rendering="crispEdges"/>
  <rect x="84" y="34" width="32" height="8" fill="#CD853F" shape-rendering="crispEdges"/>
  <!-- map scroll -->
  <rect x="142" y="105" width="20" height="30" rx="3" fill="#F5DEB3" shape-rendering="crispEdges"/>
  <rect x="145" y="108" width="14" height="24" fill="#FFE4B5" shape-rendering="crispEdges"/>
  <rect x="147" y="112" width="10" height="2" fill="#8B4513"/>
  <rect x="147" y="116" width="10" height="2" fill="#8B4513"/>
  <rect x="147" y="120" width="6" height="2" fill="#8B4513"/>
</svg>
